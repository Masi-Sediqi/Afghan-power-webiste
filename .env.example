# API
PORT=3001
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-24-characters

# Admin login (does not require PostgreSQL)
ADMIN_EMAIL=admin@afghanpower.com
ADMIN_PASSWORD=change-this-admin-password

# Customer authentication / future dynamic content
DATABASE_URL=postgresql://afghanpower:CHANGE_ME@127.0.0.1:5432/afghanpower_web
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Vite build
VITE_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
